datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OccupationType {
  student
  professional
}

enum GoalType {
  focus_minutes
  max_screen_minutes
  max_context_switches
  custom
}

enum GoalPeriod {
  daily
  weekly
}

enum DevicePlatform {
  chrome
  windows
  android
}

enum ActivitySource {
  browser
  desktop
  mobile
}

enum CategoryKind {
  domain
  app
}

enum Category {
  productive
  social
  communication
  entertainment
  other
}

enum FocusSessionStatus {
  active
  completed
  abandoned
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskStatus {
  todo
  in_progress
  completed
  cancelled
}

enum Role {
  user
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(user)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  profile             Profile?
  refreshTokens       RefreshToken[]
  goals               Goal[]
  devices             Device[]
  pairingCodes        PairingCode[]
  activityLogs        ActivityLog[]
  contextSwitches     ContextSwitch[]
  notificationEvents  NotificationEvent[]
  focusSessions       FocusSession[]
  dailyUsageStats     DailyUsageStat[]
  hourlyUsagePatterns HourlyUsagePattern[]
  recommendations     Recommendation[]
  notificationPreference NotificationPreference?
  smartAlerts         SmartAlert[]
  tasks               Task[]
  aiInsights          AIInsight[]
  adminAuditLogs      AdminAuditLog[]        @relation("AdminAuditActions")
}

enum RecommendationCategory {
  focus_improvement
  productivity_tip
  attention_recovery
  pattern_optimization
  distraction_reduction
  productivity_improvement
  break_scheduling
  application_usage
  task_prioritization
  habit_formation
}

enum RecommendationStatus {
  pending
  accepted
  dismissed
  completed
}

model Recommendation {
  id           String                 @id @default(uuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     RecommendationCategory
  title        String
  description  String
  reason       String
  actionType   String?
  actionPayload Json?
  impactScore  Int                    @default(5)
  status       RecommendationStatus   @default(pending)
  dismissedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([userId, status, createdAt(sort: Desc)])
}

model NotificationPreference {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  distractionAlerts     Boolean  @default(true)
  breakReminders        Boolean  @default(true)
  focusSessionAlerts    Boolean  @default(true)
  weeklyReportAlerts    Boolean  @default(true)
  taskDeadlineAlerts    Boolean  @default(true)
  recommendationAlerts  Boolean  @default(true)
  quietHoursEnabled     Boolean  @default(false)
  quietHoursStart       String   @default("22:00")
  quietHoursEnd         String   @default("08:00")
  updatedAt             DateTime @default(now()) @updatedAt
}

model SmartAlert {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String
  severity    String    @default("info")
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
}

model Profile {
  userId         String         @id
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  timezone       String         @default("UTC")
  occupationType OccupationType @default(student)
  workStart      String         @default("09:00")
  workEnd        String         @default("17:00")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Goal {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        GoalType
  period      GoalPeriod
  targetValue Int
  customName  String?
  createdAt   DateTime   @default(now())

  @@index([userId])
}

model Device {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   DevicePlatform @default(chrome)
  tokenHash  String         @unique
  lastSeenAt DateTime?
  revokedAt  DateTime?
  isSample   Boolean        @default(false)
  createdAt  DateTime       @default(now())

  activityLogs       ActivityLog[]
  contextSwitches    ContextSwitch[]
  notificationEvents NotificationEvent[]

  @@index([userId])
}

model PairingCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model DomainCategory {
  id       String       @id @default(uuid())
  kind     CategoryKind @default(domain)
  pattern  String
  category Category

  @@unique([kind, pattern])
}

model ActivityLog {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  clientEventId String
  source        ActivitySource @default(browser)
  domain        String?
  appName       String?
  category      Category
  startedAt     DateTime
  endedAt       DateTime
  durationSec   Int
  idle          Boolean

  @@unique([deviceId, clientEventId])
  @@index([userId, startedAt(sort: Desc)])
}

model ContextSwitch {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  clientEventId String
  fromApp       String
  toApp         String
  switchedAt    DateTime

  @@unique([deviceId, clientEventId])
  @@index([userId, switchedAt(sort: Desc)])
}

model NotificationEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  clientEventId String
  sourceApp     String
  receivedAt    DateTime

  @@unique([deviceId, clientEventId])
  @@index([userId, receivedAt(sort: Desc)])
}

model FocusSession {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId            String?
  task              Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  plannedMin        Int
  startedAt         DateTime
  endedAt           DateTime?
  status            FocusSessionStatus
  interruptionCount Int                @default(0)
  createdAt         DateTime           @default(now())

  @@index([userId, startedAt(sort: Desc)])
}

model Task {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         String         @default("work")
  priority         TaskPriority   @default(medium)
  status           TaskStatus     @default(todo)
  estimatedMinutes Int?           @default(30)
  deadline         DateTime?
  completedAt      DateTime?
  order            Int            @default(0)
  focusSessions    FocusSession[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, status, deadline])
}

model AIInsight {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  content     String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, type, createdAt(sort: Desc)])
}

model DailyUsageStat {
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String
  totalScreenSec    Int
  activeSec         Int
  idleSec           Int
  switchCount       Int
  notificationCount Int
  topSites          Json
  topApps           Json   @default("[]")
  byCategory        Json

  @@id([userId, date])
}

model HourlyUsagePattern {
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              String
  hour              Int
  activeSec         Int
  idleSec           Int
  switchCount       Int
  notificationCount Int

  @@id([userId, date, hour])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminAuditActions", fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

{
  "manifest_version": 3,
  "name": "Digital Attention Tracker",
  "version": "1.0.0",
  "description": "Opt-in tracking of active website and time spent for your local attention-management project.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Digital Attention Tracker"
  }
}